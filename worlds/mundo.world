# Author: David

include "pioneer.inc"
include "map.inc"
include "objects.inc"
include "sick.inc"

window
( 
  size [ 695 750 ] 
  center [-2.280 2.486] 
  rotate [ 28.000 -154.000 ]
  scale 31.046 
  show_data 1 # make sure we can see the effect of the controller
)

floorplan
( 
  name "rink"
  size [30.000 30.000 1.000]
  pose [0.000 0.000 0.000 0.000 ]
  bitmap "bitmaps/rink.png"  
)

floorplan2
(
 name "verde"
 size [2.000 2.000 0.000]
 pose [8.000 6.000 0.000 0.000 ]
 color "green"
)

floorplan2
(
 name "verde2"
 size [2.000 2.000 0.000]
 pose [0.000 -10.000 0.000 0.000 ]
 color "green"
)

