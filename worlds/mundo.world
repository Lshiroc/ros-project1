pioneer2dx
(
  name "robot_0"
  pose [ -11.333 6.307 0.000 177.617 ]
  color "blue"
  sicklaser
  ( 
     # plug the ../examples/ctrl/lasernoise.cc module into this laser
     ctrl "lasernoise" 

   alwayson 1 # don't wait for a subscriber
  ) 
)

pioneer2dx
(
  name "robot_1"
  pose [ -0.300 -0.889 0.000 0.000 ]
  color "red"
  sicklaser
  ( 
     # plug the ../examples/ctrl/lasernoise.cc module into this laser
     ctrl "lasernoise" 

   alwayson 1 # don't wait for a subscriber
  ) 
)

